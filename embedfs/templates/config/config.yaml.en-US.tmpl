########################################################################
# Profile
# Identity for the project or workspace described by this config file
########################################################################
profile:
  # Project name (auto-filled during init)
  name: ""
  # Init mode: project (single project) or workspace (multi-project workspace). Locked after learning or generation starts
  mode: "project"
  # Primary language, auto-detected during init; empty when unknown
  language: ""
  # Tool output, config-template, and seed-context template language: zh-CN (Chinese) or en-US (English)
  locale: "en-US"
  # Git remote repository URL (auto-filled during init)
  git_remote: ""
  # Project root directory absolute path (auto-filled during init)
  root_path: ""
  # Project initialization time (auto-filled during init)
  initialized_at: ""

########################################################################
# Workspace
# Only used in workspace mode, ordinary project child repositories usually do not need this
########################################################################
workspace:
  # Child projects, for example: [{id: "project-a", path: "project-a", type: "application", language: "primary-language"}]
  projects: []

########################################################################
# Agent
# Controls the Agent engine and concurrency used by learning and generation
########################################################################
agent:
  # Agent engine used for analysis, learning, and generation summaries; matches keys in commands
  engine: "claude"
  # Mapping from Agent engine to local CLI command; only controls how analysis agents are invoked
  commands:
    claude: "claude"
    codex: "codex"
  # AI request timeout (seconds)
  timeout: 1800
  # Maximum exploration turns for one Agent call; stops at the limit to bound context growth
  # Applies only to the Claude engine; other engines ignore this setting
  max_turns: 80
  # Whether agents may load user plugins; disabled by default for batch stability
  allow_user_plugins: false
  # Agent parallelism; workspace roots use it for child projects, project configs use it for evidence-focus batches, 0 means automatic
  parallelism: 0
  # skills-seed specific model name; empty inherits the local Agent CLI default
  model: ""
  # Retry configuration for retryable errors such as 429 and 529 overloaded
  retry:
    # Maximum retry attempts; 0 uses default (3)
    max_retries: 3
    # Initial retry wait in seconds
    initial_interval: 15
    # Maximum wait in seconds (exponential backoff cap)
    max_interval: 120

########################################################################
# Learning
# Controls the learning strategy and structural context for learn current
########################################################################
learning:
  current:
    # All learning strategies use high-precision admission: fast narrows exploration, normal is the default, and deep broadens evidence exploration without lowering admission standards
    mode: "normal"
    # Pattern candidate admission thresholds, each in (0, 1]
    pattern_admission:
      # Minimum confidence for candidates with evidence in multiple files
      min_confidence: 0.75
      # Minimum confidence for candidates with evidence in one file
      min_single_evidence_confidence: 0.85
    agenda:
      # Deterministic fallback focus size for paths omitted by AI planning
      fallback_paths_per_focus: 256
    structural:
      # Enable bounded structural context; it does not run without bounded inputs
      enabled: true
      # Structural context provider: auto prefers CodeGraph with automatic repair, then falls back to tree-sitter; codegraph or treesitter can be forced
      provider: "auto"
      # Maximum symbols emitted into structural context
      max_symbols: 30
      # Skip individual files larger than this size (KB)
      max_file_size: 512

########################################################################
# Skills
# Controls the generated Skills target type, output paths, and AI/Skills content language
########################################################################
skills:
  # Target Skills type; can differ from agent.engine, for example use claude to generate codex skills
  target: "claude"
  # Language used for AI output, persisted learned content, and generated Skills: zh-CN (Chinese) or en-US (English)
  locale: "en-US"
  # Mapping from Skills target type to output directory; only controls where generated artifacts are saved
  paths:
    claude: ".claude/skills/skills-seed-skills"
    codex: ".agents/skills/skills-seed-skills"

########################################################################
# Logging
# Controls command log level, path, and retention
########################################################################
logging:
  # Log level: DEBUG, INFO, WARN, ERROR
  level: "DEBUG"
  # Log path (relative to .skills-seed directory)
  logs_path: "runtime/logs"
  # Maximum number of log files (auto-cleanup)
  max_log_files: 30

########################################################################
# Global Exclusions
# Controls file boundaries shared by learning, preview, and structural analysis
########################################################################
exclude:
  # Whether to exclude files matched by Git ignore rules
  gitignore: true
  # Relative paths or globs to exclude; init writes the default static exclusion rules
  paths:
    # Dot-prefixed files and directories, such as .github, .cursor, .env
    - ".*"
    # Common dependency directory
    - "vendor/**"
    # Common dependency directory
    - "node_modules/**"
    # Common build output directory
    - "dist/**"
    # Common build output directory
    - "build/**"
    # Common output directory
    - "out/**"
    # Common build output directory
    - "target/**"
    # Coverage report directory
    - "coverage/**"
    # Cache directory
    - ".cache/**"
    # Temporary directory
    - "tmp/**"
    # Temporary directory
    - "temp/**"
    # Log files
    - "*.log"
    # Temporary files
    - "*.tmp"
    # Backup files
    - "*.bak"
    # Editor swap files
    - "*.swp"
    # Archives
    - "*.zip"
    # Archives
    - "*.tar"
    # Archives
    - "*.tar.gz"
    # Archives
    - "*.tgz"
    # Archives
    - "*.rar"
    # Archives
    - "*.7z"
    # Image assets
    - "*.png"
    # Image assets
    - "*.jpg"
    # Image assets
    - "*.jpeg"
    # Image assets
    - "*.gif"
    # Image assets
    - "*.webp"
    # Icon assets
    - "*.ico"
    # Document artifacts
    - "*.pdf"
    # Video assets
    - "*.mp4"
    # Video assets
    - "*.mov"
